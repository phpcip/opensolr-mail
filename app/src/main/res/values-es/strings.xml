    <string name="search_needs_account_title">La búsqueda necesita una cuenta de Opensolr</string>
    <string name="search_needs_account_text">Tu correo se busca en un Opensolr Index de tu cuenta de Opensolr. Sin ella no hay búsqueda ni respuestas de IA, y el correo nuevo se comprueba cada 15 minutos en lugar de llegar al instante. Leer, escribir, notas y calendarios funcionan igual.</string>
