    <string name="pw_no_vec_title">La búsqueda por significado no está en tu plan</string>
    <string name="pw_no_vec_text">El correo se encuentra solo por sus palabras y no hay respuestas de IA. Elige un plan con IA en opensolr.com/pricing para encontrarlo también por lo que significa.</string>
    <string name="pw_ai_full_title">Solicitudes de IA del mes agotadas</string>
    <string name="pw_ai_full_text">La búsqueda con IA y las respuestas de IA están apagadas hasta que se renueve la cuota: la búsqueda solo encuentra palabras y el correo nuevo recibe su significado más tarde. Mejora el plan para recuperarlas ya.</string>
    <string name="pw_ai_90_title">Solicitudes de IA casi agotadas</string>
    <string name="pw_ai_90_text">Se han usado %1$s de %2$s solicitudes de IA mensuales. Cuando se acaben, la búsqueda con IA y las respuestas de IA se detienen hasta que se renueve la cuota.</string>
    <string name="pw_disk_full_title">Tu índice de correo se quedó sin espacio en disco</string>
    <string name="pw_disk_full_text">Opensolr cerró el índice: el correo nuevo no se indexa y la búsqueda se detiene hasta que liberes espacio o mejores el plan.</string>
    <string name="pw_disk_90_title">Espacio en disco casi agotado</string>
    <string name="pw_disk_90_text">El índice usa el %1$s de su espacio en disco. Cuando se llene, la indexación y la búsqueda se detienen hasta que mejores el plan.</string>
    <string name="pw_bw_full_title">Tu índice de correo se quedó sin ancho de banda</string>
    <string name="pw_bw_full_text">Opensolr cerró el índice hasta fin de mes: la indexación y la búsqueda se detienen hasta que empiece el mes o mejores el plan.</string>
    <string name="pw_bw_90_title">Ancho de banda casi agotado</string>
    <string name="pw_bw_90_text">El índice usó el %1$s del ancho de banda del mes. Cuando se acabe, la indexación y la búsqueda se detienen hasta que empiece el mes.</string>
