    <string name="pw_no_vec_title">Search by meaning is not on your plan</string>
    <string name="pw_no_vec_text">Mail is found by its words only, and there are no AI answers. Pick a plan with AI at opensolr.com/pricing to also find mail by what it means.</string>
    <string name="pw_ai_full_title">Monthly AI requests used up</string>
    <string name="pw_ai_full_text">AI search and AI answers are off until the allowance resets: search matches words only, and new mail gets its meaning later. Upgrade to have them back now.</string>
    <string name="pw_ai_90_title">AI requests almost used up</string>
    <string name="pw_ai_90_text">%1$s of %2$s monthly AI requests are used. When they run out, AI search and AI answers stop until the allowance resets.</string>
    <string name="pw_disk_full_title">Your mail index is out of disk space</string>
    <string name="pw_disk_full_text">Opensolr closed the index: new mail is not indexed and search stops until you free space or upgrade your plan.</string>
    <string name="pw_disk_90_title">Disk space almost used up</string>
    <string name="pw_disk_90_text">The index uses %1$s of its disk space. When it is full, indexing and search stop until you upgrade.</string>
    <string name="pw_bw_full_title">Your mail index is out of bandwidth</string>
    <string name="pw_bw_full_text">Opensolr closed the index for the rest of the month: indexing and search stop until the month resets or you upgrade.</string>
    <string name="pw_bw_90_title">Bandwidth almost used up</string>
    <string name="pw_bw_90_text">The index used %1$s of this month\'s bandwidth. When it runs out, indexing and search stop until the month resets.</string>
